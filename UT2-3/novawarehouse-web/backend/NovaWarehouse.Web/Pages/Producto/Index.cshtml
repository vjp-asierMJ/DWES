@page

@model ProductoModel
@{
    ViewData["title"] = "Producto";
}


<h1>@Model.Product.Name</h1>
<p>Precio: @Model.Product.Price.ToString("C") (con IVA: @Model.PriceWithVat.ToString("C"))</p>
<p class="@(Model.LowStock ? "low-stock" : null)">Stock: @Model.Product.Stock uds</p>
<p>@(Model.LowStock ? "¡Quedan pocas unidades!" : "Stock suficiente")</p>
<button disabled="@(Model.Product.Stock == 0)">Añadir al pedido</button>